{
  "browser": {
    "launchOptions": {
      "headless": true,
      "args": [
        "--use-fake-ui-for-media-stream",
        "--use-fake-device-for-media-stream",
        "--autoplay-policy=no-user-gesture-required"
      ]
    },
    "contextOptions": {
      "viewport": {
        "width": 1440,
        "height": 1000
      },
      "permissions": [
        "microphone"
      ]
    }
  }
}
