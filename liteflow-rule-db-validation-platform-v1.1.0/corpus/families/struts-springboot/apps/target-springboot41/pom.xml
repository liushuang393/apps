<?xml version="1.0" encoding="UTF-8"?>
<!--
  変換のゴールとなる Spring Boot 4.1.0 の実プロジェクト。
  ケースの output/ に置いてある「期待する正解」を scripts\samples-build.cmd がここへ配置して
  mvn package し、実際に起動してログイン画面と検索一覧画面が HTTP 200 で返ることまで確かめる。

  注意: 本検証基盤そのものは Spring Boot 4.0.6 で動いている。4.1 はここ（変換先の題材）だけ。
  このプロジェクトの依存jarは、生成コードを javac するときのクラスパスとしても使う
  （scripts\samples-build.ps1 が lib/ へ集め、TRANSFORM_EXTRA_CLASSPATH で渡す）。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>jp.co.softroad.modern</groupId>
  <artifactId>target-springboot41-app</artifactId>
  <version>1.0.0</version>
  <name>Target Spring Boot 4.1 application (login + search list)</name>

  <properties>
    <java.version>17</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>target-springboot41-app</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
